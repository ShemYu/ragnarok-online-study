  "write_controls": [
    {
      "id": "Q01",
      "scenario": "positive_short_write_then_remaining",
      "response": {
        "initial_length": 3,
        "steps": [
          {
            "data_hex": "616263"
          },
          {
            "eof": true
          }
        ]
      },
