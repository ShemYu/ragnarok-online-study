      "expected_exception": {
        "type": "OSError",
        "no_transfer_result": true
      },
      "expected_stored_hex": "61",
      "expected_effects": {
        "error_injection_observed": true,
        "caller_fd_stays_open": true,
        "first_positive_write_observed": true
      },
      "note": "If the first write request exceeds one byte this is a mid-chunk error; if not, it is a completed one-byte chunk followed by error. No result/hash/count is fabricated on either exception path."
    }
