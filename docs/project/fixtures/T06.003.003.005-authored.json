      "clock": {
        "initial_value": 0
      },
      "write_plan": [
        {
          "return_zero_without_storing": true
        },
        {
          "safety_sentinel_if_called": "AssertionError: retried after zero"
        }
      ],
      "expected_exception": {
        "type": "OSError",
        "no_transfer_result": true
      },
      "expected_stored_hex": "",
      "expected_effects": {
        "zero_injection_observed": true,
        "write_calls": 1,
        "caller_fd_stays_open": true
      }
    },
