      "write_plan": [
        {
          "actually_store_at_most": 1
        },
        {
          "actually_store": "all_remaining"
        }
      ],
      "expected": {
        "outcome": "complete",
        "bytes": 3,
        "response_complete": true,
        "complete_sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        "partial_sha256": null,
        "late": false
      },
      "expected_stored_hex": "616263",
      "expected_effects": {
        "caller_fd_stays_open": true,
        "positive_short_injection_observed_if_multi_byte_buffer_requested": true
      },
      "applicability": "Inject a genuinely positive short write when the candidate requests more than one byte. A valid byte-at-a-time implementation may have no such callback opportunity; retain exact result/storage checks and report that short-write path as not exercised, not as observed fault evidence."
    },
    {
      "id": "Q02",
      "scenario": "zero_write_raises_without_retry",
      "response": {
        "initial_length": 3,
        "steps": [
          {
            "data_hex": "616263"
          },
          {
            "eof": true
          }
