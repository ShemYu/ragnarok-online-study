{
  "schema": "T06-map-dependency-observation-authored-1",
  "status": "FROZEN_ROOT_REVIEWED",
  "provenance": "Tiny authored literals, prepared by an internal aide and independently reviewed by root before the actual Claude/Grok pair; no runtime or provider credit.",
  "case_counts": {
    "wire": 16,
    "transport": 11,
    "write_controls": 3,
    "signature": 10
  },
  "api_contract": {
    "wire_target": {
      "arguments": [
        "http_path"
      ],
      "returns": "slash followed by unchanged ASCII encoded path",
      "refuses": [
        "empty",
        "non-ASCII",
        "ASCII C0 or DEL control",
        "literal space",
        "literal ? or #",
        "leading slash",
        "repeated slash",
        "dot or dotdot segment",
        "malformed percent escape"
      ],
      "refusal": "ValueError with generic message and no raw path echo",
      "preserves": [
        "case",
        "valid percent-escape spelling and hex case",
        "!'()*"
      ]
    },
    "transfer": {
      "arguments": [
        "response",
        "fd"
      ],
      "keyword_arguments": [
        "body_cap",
        "aggregate_left",
        "deadline",
        "clock=None",
        "write_fn=None"
      ],
      "result_keys": [
        "outcome",
        "bytes",
        "response_complete",
        "complete_sha256",
        "partial_sha256",
        "late"
      ],
      "outcomes": [
        "complete",
        "declared_over_cap",
        "cap_unresolved_eof",
        "aggregate_cap",
        "deadline",
        "transport_error"
      ],
      "late": "final clock() >= deadline for every returned outcome",
      "empty_framing": "response.length == 0 is handled before the read-deadline gate",
      "complete_hash": "SHA256 of fully stored chunks on complete outcome; partial hash null",
      "noncomplete_hash": "complete hash null; partial hash SHA256 of fully stored chunks, including empty",
      "storage_error": "propagate OSError, no transfer result, caller retains and must close fd; do not retry after zero write"
    },
    "inspect_signature": {
      "arguments": [
        "kind",
        "prefix"
      ],
      "kinds": [
        "model",
        "bmp",
        "jpeg"
      ],
      "minimum_lengths": {
        "model": 6,
        "bmp": 2,
        "jpeg": 2
      },
      "result_keys": [
        "state",
        "prefix_hex"
      ],
      "short": "available prefix length below minimum",
      "match": {
        "model": [
          "4752534d",
          "47525358"
        ],
        "bmp": [
          "424d"
        ],
        "jpeg": [
          "ffd8"
        ]
      },
      "prefix_hex": "hex of first minimum bytes, or all bytes if shorter; extra bytes ignored"
    }
  },
  "fixture_adapter_rules": {
    "response_length": "Nonnegative remaining framed byte count or null. read1(max_bytes) returns at most max_bytes, splitting a data step as needed; it decrements framed length by returned byte count. EOF leaves any positive framing remainder unchanged.",
    "response_steps": "A data step advances only when fully served; clock_when_fully_served then updates the fake clock. eof returns empty bytes; raises throws the named authored exception. No real HTTP object is created.",
    "clock": "Returns initial_value until a data-step update; no prescribed number of clock() calls. Equality at deadline counts late.",
    "storage": "Runner supplies an initially empty caller-owned temporary fd and compares physical stored bytes before caller cleanup. write_plan short writes must actually store the reported bytes.",
    "write_fn": "write_fn(fd, bytes-like-buffer) -> int excluding bool in 1..remaining; zero/invalid/overlarge counts raise OSError without retry.",
    "read_effects": "No fixed read call count is imposed except an explicitly forbidden read/EOF lookahead. Assert no read request after the named exhausted cap and retain the scripted unread payload.",
    "wire_errors": "ValueError class and generic-no-echo policy are fixed; exact message text is not prescribed."
  },
