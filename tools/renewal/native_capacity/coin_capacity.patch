+/// ros_ch1_coin_capacity();
+/// Pushes 1 when an ordinary Ch1_Root_Coin x10 fits the attached player now,
+/// 0 for a native capacity refusal and -1 for an unsupported actor, item or
+/// configuration. Read-only: nothing is created, reserved or sent. Every
+/// handled outcome pushes one value and succeeds; the value alone decides.
+BUILDIN_FUNC(ros_ch1_coin_capacity)
+{
+	map_session_data* sd;
+	std::shared_ptr<item_data> id;
+
+	if( script_hasdata(st, 2) ){
+		ShowError("buildin_ros_ch1_coin_capacity: Takes no arguments.\n");
+		script_pushint(st, -1);
+		return SCRIPT_CMD_SUCCESS;
+	}
+
+	sd = map_id2sd(st->rid);
+
+	if( sd == nullptr ){
+		script_pushint(st, -1);
+		return SCRIPT_CMD_SUCCESS;
+	}
+
+	id = item_db.searchname( "Ch1_Root_Coin" );
+
+	if( id == nullptr || id->nameid != 1001972 || pet_db_search( id->nameid, PET_EGG ) != nullptr ){
+		script_pushint(st, -1);
+		return SCRIPT_CMD_SUCCESS;
+	}
+
+	script_pushint(st, pc_ch1_coin_capacity(sd, id.get()));
+	return SCRIPT_CMD_SUCCESS;
+}
