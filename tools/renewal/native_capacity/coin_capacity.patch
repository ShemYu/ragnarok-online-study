+/** Read-only probe: would pc_additem insert an ordinary Ch1_Root_Coin x10 now?
+ * Same early checks as pc_additem (without GUID generation), then the shared plan.
+ * @param sd Player
+ * @param id Resolved item data of Ch1_Root_Coin
+ * @return 1 fits, 0 native capacity refusal, -1 unsupported item/actor/arithmetic
+ */
+int32 pc_ch1_coin_capacity( const map_session_data* sd, const struct item_data* id ){
+	const int32 amount = 10;
+	struct item it = {};
+	int16 i;
+	bool merge;
+	uint32 w;
+
+	if( sd == nullptr || id == nullptr || id->nameid != 1001972 )
+		return -1;
+	if( id->type != IT_ETC || !itemdb_isstackable2(id) || id->flag.guid )
+		return -1;
+	if( sd->status.inventory_slots > MAX_INVENTORY )
+		return -1;
+	for( i = 0; i < MAX_INVENTORY; i++ ){
+		if( sd->inventory.u.items_inventory[i].nameid != 0 &&
+			( sd->inventory.u.items_inventory[i].amount <= 0 || sd->inventory.u.items_inventory[i].amount > MAX_AMOUNT ) )
+			return -1;
+	}
+	if( id->weight > UINT32_MAX / amount )
+		return -1;
+	w = id->weight*amount;
+	if( w > UINT32_MAX - sd->weight )
+		return -1;
+
+	if( amount > MAX_AMOUNT )
+		return 0;
+	if( id->stack.inventory && amount > id->stack.amount )
+		return 0;
+	if( sd->weight + w > sd->max_weight )
+		return 0;
+
+	it.nameid = id->nameid;
+	it.identify = 1;
+	it.bound = BOUND_NONE;
+
+	return ( pc_additem_plan(sd, &it, amount, id, &i, &merge) == ADDITEM_SUCCESS ) ? 1 : 0;
 }
 
